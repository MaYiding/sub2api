[Unit]
Description=Expire raw AI log archive packs already compacted into session files
After=network-online.target ai-archive.service
Wants=network-online.target
[Service]
Type=oneshot
User=ailog
Group=ailog
WorkingDirectory=/opt/ai-log-pipeline/src
Environment=PYTHONDONTWRITEBYTECODE=1
# AI_LOG_PROMETHEUS_URL: the Prometheus that scrapes the sessionizer host.
EnvironmentFile=/etc/ai-logs/pipeline/retention.env
ExecStart=/opt/ai-log-pipeline/venv/bin/python /opt/ai-log-pipeline/src/archive_retention.py --config /etc/ai-logs/pipeline/archiver.json --prometheus ${AI_LOG_PROMETHEUS_URL} --days 30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-log-pipeline
Nice=10
