<mxfile host="app.diagrams.net"><diagram id="multi-site" name="多站点注册与上报"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="980" pageHeight="700" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Sub2API 两地部署 · 独立凭据 · 共用日志平台&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fontSize=22;fontColor=#18324b;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry" /></mxCell><mxCell id="admin" value="&lt;b&gt;中央接入管理页&lt;/b&gt;&lt;br&gt;注册 / 轮换 / 停用" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontColor=#18324b;spacing=7;fillColor=#fff0d5;strokeColor=#7694b3;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="140" height="60" as="geometry" /></mxCell><mxCell id="registry" value="&lt;b&gt;注册库 SQLite&lt;/b&gt;&lt;br&gt;来源 / 凭据 / 作业" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontColor=#18324b;spacing=7;fillColor=#fff0d5;strokeColor=#7694b3;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="140" height="60" as="geometry" /></mxCell><mxCell id="provision" value="&lt;b&gt;内网配置服务&lt;/b&gt;&lt;br&gt;Topic / ACL / 绑定" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontColor=#18324b;spacing=7;fillColor=#fff0d5;strokeColor=#7694b3;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="140" height="60" as="geometry" /></mxCell><mxCell id="status" value="&lt;b&gt;分站点状态&lt;/b&gt;&lt;br&gt;心跳 / 积压 / 归档" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontColor=#18324b;spacing=7;fillColor=#fff0d5;strokeColor=#7694b3;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="140" height="60" as="geometry" /></mxCell><mxCell id="a" value="&lt;b&gt;站点 A&lt;/b&gt;&lt;br&gt;WAL + shipper&lt;br&gt;source A / 凭据 A" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontColor=#18324b;spacing=7;fillColor=#eaf1fb;strokeColor=#7694b3;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y